{
  "name": "netvyl-business-management-platform",
  "version": "1.0.0-v36",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "web:dev": "next dev",
    "build": "next build",
    "web:build": "next build",
    "start": "next start",
    "web:start": "next start",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "import:legacy": "node scripts/import-legacy.mjs",
    "build:web": "next build",
    "electron:dev": "electron .",
    "desktop:electron:dev": "electron .",
    "electron:build": "npm run build:web && electron-builder --win nsis",
    "desktop:electron:build": "npm run build:web && electron-builder --win nsis",
    "electron:build:portable": "npm run build:web && electron-builder --win portable",
    "desktop:electron:build:portable": "npm run build:web && electron-builder --win portable",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "android:open": "npm run mobile:build && npx cap sync && npx cap open android",
    "ios:open": "npm run mobile:build && npx cap sync && npx cap open ios",
    "android:run": "npm run mobile:build && npx cap sync && npx cap run android",
    "ios:run": "npm run mobile:build && npx cap sync && npx cap run ios",
    "mobile:build": "node scripts/build-mobile.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2"
  },
  "main": "electron/main.cjs"
}
